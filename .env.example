# Copy this file to .env.local and fill in your own key.
# Get a key at https://platform.openai.com/api-keys
# Never commit .env.local or share the key.
OPENAI_API_KEY=

# Optional: override the default model (used by evals to compare models).
# OPENAI_MODEL=gpt-5.4-mini

# Optional: abuse protection for the public demo (in-memory, per server instance).
# Analyses per IP per 10 minutes:
# RATE_LIMIT_PER_IP=5
# Analyses per day in total:
# RATE_LIMIT_DAILY=300
